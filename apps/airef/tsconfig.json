{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node", "chrome"]
  },
  "include": ["src", "server", "functions", "capture-relay", "extension", "scripts", "tests", "vite.config.ts", "vite.helper.config.ts"]
}
