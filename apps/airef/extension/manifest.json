{
  "manifest_version": 3,
  "name": "AIRef capture helper",
  "version": "0.2.0",
  "description": "Capture loaded text and code from a public ChatGPT or Claude share page for review in AIRef.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Capture this shared conversation"
  },
  "minimum_chrome_version": "112",
  "key": "",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "externally_connectable": {
    "matches": [
      "https://airef.ojwatson.co.uk/*",
      "https://preview.airef-8ej.pages.dev/*"
    ]
  }
}
